# Copy to an untracked .env.production on the VPS and replace every placeholder.
# Never commit the populated file.
COMPOSE_PROJECT_NAME=darmalton
DARMALTON_BACKEND_IMAGE=darmalton-backend-production:local
DARMALTON_WEBSITE_IMAGE=darmalton-website-production:local
POSTGRES_DB=darmalton
POSTGRES_USER=darmalton
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://darmalton:URL_ENCODED_PASSWORD@db:5432/darmalton
DATABASE_CONN_MAX_AGE=60

DJANGO_PRODUCTION=true
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_AT_LEAST_50_RANDOM_CHARACTERS
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_ANON_THROTTLE_RATE=120/min
DJANGO_USER_THROTTLE_RATE=600/min
DJANGO_LOG_LEVEL=INFO
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PRESCRIPTION_MAX_UPLOAD_BYTES=10485760

DARMALTON_WEB_HOST=example.com
DARMALTON_API_HOST=api.example.com
TRAEFIK_CERT_RESOLVER=letsencrypt
API_INTERNAL_URL=http://backend:8000/api/v1
API_INTERNAL_FORWARDED_PROTO=https
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
