# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-development-key
DJANGO_DEBUG=false
# scripts/dev-up.ps1 updates this ignored setting with the active private LAN IP.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://pharmacy:change-me@db:5432/pharmacy
DATABASE_CONN_MAX_AGE=60
DJANGO_USE_SQLITE=false
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Google Identity Services. The client ID is public and shared by the web
# button, mobile ID-token audience, and backend verifier. The client secret
# remains server-side and is never exposed to Next.js browser code or Flutter.
GOOGLE_CLIENT_ID=replace-with-google-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# PostgreSQL container
POSTGRES_DB=pharmacy
POSTGRES_USER=pharmacy
POSTGRES_PASSWORD=change-me

# Website (server-side and browser-visible API URLs)
API_INTERNAL_URL=http://backend:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Optional browser-visible origin for Django Admin. When blank, the website
# preserves the request host and redirects from port 3000 to this backend port.
DJANGO_ADMIN_ORIGIN=
DJANGO_ADMIN_PORT=8000

# Development seed command; change before sharing any environment
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=ChangeMe-Admin-123!
DEMO_CUSTOMER_EMAIL=customer@example.test
DEMO_CUSTOMER_PASSWORD=ChangeMe-Customer-123!
